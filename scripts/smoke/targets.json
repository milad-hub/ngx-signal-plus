    "jasmineCore": "5.4.0",
    "jasmineTypes": "5.1.4",
    "minNode": "20.19.0",
    "moduleResolution": "bundler",
    "legacyPeerDeps": false,
    "optional": true,
    "optionalReason": "a control lane, not part of the declared peer range; run it with --only=20 to prove the harness itself is sound",
    "dependencies": {},
